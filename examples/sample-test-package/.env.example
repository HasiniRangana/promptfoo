# Environment variables for Promptfoo testing
# Copy this file to .env and configure with your API keys

# OpenAI API Configuration (Required for most tests)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Configuration (Optional)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Azure OpenAI Configuration (Optional)
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com

# Promptfoo Configuration
PROMPTFOO_CACHE_ENABLED=true
PROMPTFOO_LOG_LEVEL=info
PROMPTFOO_MAX_CONCURRENCY=3
PROMPTFOO_DELAY_MS=1000

# Database Configuration (for MySQL migration testing)
# PROMPTFOO_USE_MYSQL=false
# PROMPTFOO_MYSQL_HOST=localhost
# PROMPTFOO_MYSQL_PORT=3306
# PROMPTFOO_MYSQL_USER=root
# PROMPTFOO_MYSQL_PASSWORD=root
# PROMPTFOO_MYSQL_DATABASE=promptfoo