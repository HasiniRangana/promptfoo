# MySQL Database Configuration for Promptfoo
# Copy this file to .env and configure your MySQL connection details

# MySQL Connection Settings
PROMPTFOO_MYSQL_HOST=localhost
PROMPTFOO_MYSQL_PORT=3306
PROMPTFOO_MYSQL_USER=root
PROMPTFOO_MYSQL_PASSWORD=root
PROMPTFOO_MYSQL_DATABASE=promptfoo

# Set to 'true' to enable SSL connections
PROMPTFOO_MYSQL_SSL=true

# Set to 'true' to use MySQL instead of SQLite
PROMPTFOO_USE_MYSQL=true

# Enable database query logging (optional)
PROMPTFOO_ENABLE_DATABASE_LOGS=true